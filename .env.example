# Local development defaults. Start Postgres with `docker compose up -d db`.
DATABASE_URL=postgres://dainiki:dainiki@127.0.0.1:5432/dainiki
APP_BASE_URL=http://127.0.0.1:3000

# Email delivery: file | log | resend | disabled.
# `file` writes messages to MAIL_OUTBOX_DIR; `disabled` auto-verifies new
# accounts and should only be used on a trusted single-user install.
AUTH_EMAIL_MODE=file
MAIL_OUTBOX_DIR=data/outbox
EMAIL_FROM=Dainiki <hello@smbl.dev>
# RESEND_API_KEY=

# Cookies are hardened automatically when APP_BASE_URL uses https.
# Force it on or off when testing a different setup:
# SESSION_COOKIE_SECURE=true
