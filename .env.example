# Local development defaults. Start Postgres with `docker compose up -d db`.
DATABASE_URL=postgres://dainiki:dainiki@127.0.0.1:5432/dainiki
APP_BASE_URL=http://127.0.0.1:3000

# Email delivery: file | log | resend | disabled.
# `file` writes messages to MAIL_OUTBOX_DIR; `disabled` auto-verifies new
# accounts and should only be used on a trusted single-user install.
AUTH_EMAIL_MODE=file
MAIL_OUTBOX_DIR=data/outbox
EMAIL_FROM=Dainiki <hello@smbl.dev>
# Install the Resend CLI and authenticate with `resend login`, then use:
# AUTH_EMAIL_MODE=resend
# RESEND_API_KEY=
# RESEND_API_BASE_URL=https://api.resend.com

# Billing: mock | dodo. Mock activates plans locally without a payment and is
# refused outside loopback HTTP. Use dodo in production.
BILLING_MODE=mock
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Test mode:
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_MONTHLY_PRODUCT_ID=
# DODO_YEARLY_PRODUCT_ID=
# Live mode (used when DODO_PAYMENTS_ENVIRONMENT=live_mode):
# DODO_LIVE_API_KEY=
# DODO_LIVE_WEBHOOK_KEY=
# DODO_LIVE_MONTHLY_PRODUCT_ID=
# DODO_LIVE_YEARLY_PRODUCT_ID=
# Optional override for tests or a local mock server:
# DODO_PAYMENTS_API_BASE_URL=http://127.0.0.1:3999

# Cookies are hardened automatically when APP_BASE_URL uses https.
# Force it on or off when testing a different setup:
# SESSION_COOKIE_SECURE=true

# Encrypted sync storage. Sync stays disabled when these are absent.
# Local development: start RustFS with `docker compose up -d rustfs storage-init`.
SYNC_STORAGE=s3
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=dainiki
R2_SECRET_ACCESS_KEY=dainiki-minio
R2_BUCKET=dainiki-sync
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true
# Production Cloudflare R2:
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# # R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=dainiki-sync
# R2_REGION=auto
# R2_FORCE_PATH_STYLE=true
# Add a bucket CORS rule for the app origin with GET, PUT, HEAD and all headers.
