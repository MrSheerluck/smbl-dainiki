# Copy to /opt/smbl/apps/dainiki/.env on the server and fill the secrets there.
# Never commit this file with real values.

DATABASE_URL=postgres://dainiki_app:CHANGE_ME@postgres:5432/smbl
APP_BASE_URL=https://app.dainiki.smbl.dev

AUTH_EMAIL_MODE=resend
EMAIL_FROM=Dainiki <hello@smbl.dev>
RESEND_API_KEY=CHANGE_ME

BILLING_MODE=dodo
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_LIVE_API_KEY=CHANGE_ME
DODO_LIVE_WEBHOOK_KEY=CHANGE_ME
DODO_LIVE_MONTHLY_PRODUCT_ID=CHANGE_ME
DODO_LIVE_YEARLY_PRODUCT_ID=CHANGE_ME

SYNC_STORAGE=s3
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=smbl-dainiki
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# Caddy is the only proxy in front of this container. It receives requests
# from Cloudflare Tunnel on the smbl_edge network.
TRUSTED_PROXY_NETWORKS=172.30.0.0/24
